// Dental queue data model.
// SQLite for local/dev; swap the datasource provider to "postgresql" for production.

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  // Pooled connection used at runtime (serverless-friendly).
  // Both vars are injected automatically by the Vercel + Neon integration.
  url       = env("DATABASE_URL")
  // Direct connection used for migrations.
  directUrl = env("DATABASE_URL_UNPOOLED")
}

// A clinic location. Each branch runs its own independent queue.
model Branch {
  id     String  @id @default(cuid())
  // URL-friendly id, e.g. "las-pinas".
  slug   String  @unique
  name   String
  sort   Int     @default(0)
  active Boolean @default(true)

  tickets Ticket[]
}

// Dentists are shared across all branches (they alternate between locations).
model Dentist {
  id        String  @id @default(cuid())
  name      String
  specialty String?
  active    Boolean @default(true)
  sort      Int     @default(0)

  preferredTickets Ticket[] @relation("PreferredDentist")
  assignedTickets  Ticket[] @relation("AssignedDentist")
}

model Service {
  id     String  @id @default(cuid())
  name   String
  active Boolean @default(true)
  // Display order in the check-in form.
  sort   Int     @default(0)
}

model Ticket {
  id          String @id @default(cuid())
  // Per-day sequential number, e.g. 1, 2, 3...
  number      Int
  // Display code derived from number + day, e.g. "037".
  code        String
  patientName String
  phone       String?
  // JSON-encoded array of selected service names.
  services    String @default("[]")
  notes       String?

  // The branch this ticket belongs to.
  branchId String?
  branch   Branch? @relation(fields: [branchId], references: [id])

  // Patient's optional preference.
  preferredDentistId String?
  preferredDentist   Dentist? @relation("PreferredDentist", fields: [preferredDentistId], references: [id])

  // Staff assignment (can override the preference).
  assignedDentistId String?
  assignedDentist   Dentist? @relation("AssignedDentist", fields: [assignedDentistId], references: [id])

  // waiting | serving | completed | cancelled
  status String @default("waiting")

  createdAt   DateTime  @default(now())
  calledAt    DateTime?
  completedAt DateTime?

  @@index([branchId, status])
  @@index([createdAt])
}
