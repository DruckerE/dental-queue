# Copy to .env and fill in. Get these from your Postgres provider
# (Vercel Postgres / Neon / Supabase). The pooled URL is used at runtime;
# the direct (non-pooled) URL is used for migrations.
DATABASE_URL="postgresql://user:password@host/db?sslmode=require&pgbouncer=true"
DIRECT_URL="postgresql://user:password@host/db?sslmode=require"
